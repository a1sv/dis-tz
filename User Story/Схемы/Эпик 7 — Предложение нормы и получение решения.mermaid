flowchart TD
    START([Наладчик видит отклонение стойкости]) --> US71["US-7.1 СКОРРЕКТИРОВАТЬ НОРМУ"]
    US71 --> INPUT["Новое значение + причина"]
    INPUT --> SCOPE["Относится к инструменту<br/>на данной операции и рабочем месте"]
    SCOPE --> US72["US-7.2 Временная норма"]

    US72 --> N32{Н32 включена?}
    N32 -- Да --> APPLY["Применить сразу<br/>отметка «Ожидает подтверждения менеджера»"]
    N32 -- Нет --> WAIT["До решения менеджера<br/>действуют утверждённые нормы"]

    APPLY --> USE["Используется для:<br/>рекомендуемого количества в заказе<br/>+ сигнализация при Н42"]
    WAIT --> USE
    USE --> US73["US-7.3 Получение решения"]

    US73 --> DECISION{Решение менеджера}
    DECISION -- Подтверждено --> CONFIRM["Применить предложенное значение"]
    DECISION -- Другая временная --> OTHER["Назначить другую временную норму"]
    DECISION -- Возвращена обычная --> BACK["Вернуть обычную норму"]

    CONFIRM --> HISTORY["Сохранить решение и причину в журнале"]
    OTHER --> HISTORY
    BACK --> HISTORY

    HISTORY --> DONE{Наладчик уже<br/>вернул обычную норму?}
    DONE -- Да --> NOAPPLY["Подтверждение сохраняется в истории<br/>но не включает норму повторно"]
    DONE -- Нет --> APPLYNOW["Значение применяется<br/>к дальнейшим расчётам"]