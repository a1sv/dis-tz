flowchart TD
    START([Работа по заданию]) --> CHANGE{US-6.1<br/>СМЕНА ЗАДАНИЯ?}
    CHANGE -- Нет --> COUNTERS
    CHANGE -- Да --> FINAL["Ввести конечное<br/>фактическое показание"]
    FINAL --> SELECT["Выбрать другую деталь"]
    SELECT --> STATE{Состояние<br/>счётчика}
    STATE -- СЧЁТЧИК ОБНУЛЁН --> ZERO["Начало нового задания = 0"]
    STATE -- СЧЁТЧИК НЕ ОБНУЛЁН --> KEEP["Начало = сохранённое<br/>конечное показание"]
    STATE -- НЕ ЗНАЮ --> UNK["Сохранить фактическое значение<br/>расхождение без вымышленного выпуска"]
    ZERO --> SAVE["Накопленная наработка<br/>инструмента сохраняется"]
    KEEP --> SAVE
    UNK --> SAVE

    COUNTERS["US-6.2 Счётчики:<br/>1 общий или несколько<br/>по станкам и операциям"] --> WORK([Работа])

    WORK --> END{US-6.3<br/>ЗАВЕРШИТЬ СМЕНУ?}
    END -- Нет --> FIX{US-6.4<br/>Исправить ошибку?}
    END -- Да --> FINAL2["Ввести конечные<br/>фактические показания"]
    FINAL2 --> CLOSE["Закрыть смену<br/>завершить сеанс<br/>показать фото сотрудников"]
    CLOSE --> KEEP2["Открытые заявки и SOS<br/>не исчезают"]
    KEEP2 --> N11{Н11 включена?}
    N11 -- Нет --> NOCHECK["Повторный пересчёт<br/>годного остатка не требуется"]
    N11 -- Да --> CHECK["Пересчёт годного остатка<br/>перед уходом"]
    NOCHECK --> TRANSFER["Передача смены:<br/>станки могут продолжать работу"]
    CHECK --> TRANSFER

    FIX -- Да --> OWN["Исправить собственное показание<br/>пока смена открыта"]
    OWN --> HIST["Сохранить историю<br/>уведомить менеджера<br/>пересчитать зависимые значения"]
    HIST --> CANCEL{Отменить<br/>ошибочную замену?}
    CANCEL -- Да --> RECALC["Восстановить запас и наработку<br/>если цепочка однозначна"]
    CANCEL -- Нет --> WORK
    RECALC --> AMBIG{Неоднозначно?}
    AMBIG -- Да --> MANAGER["Передать менеджеру<br/>спорные значения — на проверку"]
    AMBIG -- Нет --> WORK
    MANAGER --> WORK