flowchart TD
    START([Наладчик видит нехватку]) --> ORDER["US-4.1 ЗАКАЗАТЬ ИНСТРУМЕНТ"]
    ORDER --> REC["Рекомендация:<br/>потребность периода<br/>+ страховой запас (Н16)<br/>− годный остаток<br/>− неполученное по заявке"]
    REC --> PERIOD["Н15: период обеспечения<br/>= остаток текущей + следующая смена<br/>+ страховой запас"]
    PERIOD --> N14{Н14 включена?}
    N14 -- Да --> GRAPH["Наладчик отмечает:<br/>«Работаем» / «Не работаем»<br/>на выбранные даты"]
    N14 -- Нет --> NOGRAPH["Используется настроенный график"]

    GRAPH --> FORMULA["Формула:<br/>дозаказать = max(0,<br/>потребность + запас<br/>− остаток − неполученное)"]
    NOGRAPH --> FORMULA
    FORMULA --> EXAMPLE["Пример: потребность 10, остаток 3,<br/>ожидается 4 → дозаказать 3"]
    EXAMPLE --> CONFIRM{Подтвердить?}

    CONFIRM -- Да --> US42["US-4.2 Корректировка"]
    CONFIRM -- Нет --> CANCEL["Отмена"]

    US42 --> ADJ["Наладчик может изменить<br/>рекомендацию (5 → 7)"]
    ADJ --> OPEN{Есть открытая<br/>заявка?}
    OPEN -- Да --> REUSE["Открыть её<br/>новая не создаётся"]
    OPEN -- Нет --> NEW["Создать заявку"]
    REUSE --> N19
    NEW --> N19

    N19{Н19 включена?}
    N19 -- Нет --> WAIT["Ожидание доставки"]
    N19 -- Да --> PART["Не взятая в доставку часть<br/>уменьшается сразу<br/>уже взятая — по решению менеджера"]

    WAIT --> US43["US-4.3 Получение"]
    PART --> US43

    US43 --> DELIVER["«ВАМ ДОСТАВЛЕН ИНСТРУМЕНТ»<br/>список для сверки"]
    DELIVER --> MATCH{Совпадает?}
    MATCH -- Да --> CONFIRM2["ПОДТВЕРДИТЬ<br/>запас += принятое"]
    MATCH -- Нет --> CORRECT["КОРРЕКТИРОВАТЬ<br/>указать фактически принятое"]
    CORRECT --> NOTIFY["Менеджер уведомлён<br/>о расхождении"]
    CONFIRM2 --> STORE["Сложить в место хранения годного"]
    NOTIFY --> STORE

    STORE --> US44["US-4.4 Изменение заявки в доставке"]
    US44 --> SPLIT["Пример: заказано 7, взято 7,<br/>наладчик увеличил до 10:<br/>7 в доставке + 3 к довозу"]

    STORE --> US45["US-4.5 Аварийное получение"]
    US45 --> RESERVE{Обычная выдача<br/>недоступна?}
    RESERVE -- Да --> ACCESS["Запросить доступ<br/>к защищённому хранилищу"]
    ACCESS --> APPROVE["Согласование менеджером<br/>или руководителем<br/>(возможен телефон)"]
    APPROVE --> TAKE["Получить инструмент<br/>зафиксировать: кто, что, сколько, когда"]
    TAKE --> OFFSET["Засчитать в исполнение заявки<br/>резерв −получено<br/>запас рабочего места +получено"]
    OFFSET --> REPLEN["Менеджеру:<br/>пополнить резерв на столько же"]