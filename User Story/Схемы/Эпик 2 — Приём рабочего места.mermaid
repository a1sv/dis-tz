flowchart TD
    START([Начало смены]) --> SCHEME["US-2.1 Схема сборки:<br/>пронумерованная сборка<br/>шпиндель, патрон, втулка, сверло"]

    SCHEME --> POS["У каждой позиции:<br/>название, последняя замена,<br/>накопленная наработка,<br/>данные предыдущего наладчика"]
    POS --> ACTIONS{Действие по элементу}
    ACTIONS -- СМЕНА ИНСТРУМЕНТА --> E3
    ACTIONS -- ЗАКАЗАТЬ --> E4
    ACTIONS -- СООБЩИТЬ О ПРОБЛЕМЕ --> E5
    ACTIONS -- ВЫЗВАТЬ СПЕЦИАЛИСТА --> E5

    SCHEME --> ACCEPT["US-2.2 Приём годного инструмента"]
    ACCEPT --> STORAGE["Годный и негодный хранятся раздельно<br/>видны реальные места хранения"]
    STORAGE --> REMAIN["Виден остаток:<br/>например, 3 сверла, 2 метчика"]
    REMAIN --> CHECK{Расхождение?}
    CHECK -- Нет --> BUTTON["ПРИСТУПИТЬ К РАБОТЕ<br/>(подтверждает приём остатков)"]
    CHECK -- Да --> FIX["Указать фактическое количество:<br/>недостача или повреждение"]
    FIX --> NOTIFY["Менеджер получает<br/>вид и количество расхождения"]
    NOTIFY --> BUTTON

    BUTTON --> COUNTER["US-2.3 Ввод начального показания счётчика"]
    COUNTER --> FULL["Ввести полное фактическое показание<br/>(например, 1271)"]
    FULL --> CALC["Система сама считает разницу<br/>1271 → 1644 = 373 детали"]
    CALC --> RESET{Спросить<br/>об обнулении?}
    RESET -- Да --> ANSWER{Ответ}
    ANSWER -- Обнулён --> ZERO["Начало с нуля"]
    ANSWER -- Не обнулён --> KEEP["Сохранить конечное показание"]
    ANSWER -- Не знаю --> UNKNOWN["Расхождение сохраняется<br/>менеджер уведомлён<br/>без вымышленного выпуска"]
    ZERO --> START2["ПРИСТУПИТЬ К РАБОТЕ"]
    KEEP --> START2
    UNKNOWN --> START2

    START2 --> SOSCHECK{Рабочее место<br/>в состоянии SOS?}
    SOSCHECK -- Да --> NOPROG["Приём смены не снимает остановку<br/>прогноз не запускается"]
    SOSCHECK -- Нет --> PROG["Запускается временной прогноз"]
    NOPROG --> WORK([Работа])
    PROG --> WORK