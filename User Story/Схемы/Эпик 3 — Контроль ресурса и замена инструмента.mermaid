flowchart TD
    START([Работа идёт]) --> PROG["US-3.1 Прогноз наработки:<br/>между показаниями —<br/>оценка по времени и темпу"]
    PROG --> NEXT["Следующее фактическое показание<br/>уточняет расчёт"]
    NEXT --> N42{Н42 включена?}

    N42 -- Нет --> NOALERT["Сигнализатор выключен<br/>(бета-версия)"]
    N42 -- Да --> ALERT["US-3.2 Экран мигает красным<br/>по прогнозу"]
    ALERT --> AUTH["Наладчик авторизуется<br/>проверяет сверло и отверстия"]
    AUTH --> CONTROL{КОНТРОЛИРУЮ}
    CONTROL --> STOP["Мигание прекращается<br/>фиксируется сотрудник, время, инструмент"]
    STOP --> N37{Н37 включена?}
    N37 -- Да --> ENTER["Ввод показания счётчика<br/>(точка проверки прогноза)"]
    N37 -- Нет --> NOENTER["Без показания"]
    ENTER --> WORK
    NOENTER --> WORK

    NEXT --> REPLACE{Замена?}
    REPLACE -- Нет --> WORK([Продолжение работы])
    REPLACE -- Да --> EARLY{Ранняя?<br/>(до предупреждения)}

    EARLY -- Да --> US34["US-3.4 Ранняя замена:<br/>сообщить о проблеме<br/>признак «Работа продолжается»"]
    EARLY -- Нет --> US33["US-3.3 Замена сверла"]

    US33 --> STOPM["Остановить станок<br/>взять новое сверло<br/>снять отработанное"]
    STOPM --> REQ["Кнопка СМЕНА ИНСТРУМЕНТА:<br/>фактическое показание<br/>+ причина"]
    REQ --> REASONS{Причина}
    REASONS -- ХАРАКТЕРНЫЙ ИЗНОС --> SAVE
    REASONS -- ПОЛОМКА --> SAVE
    REASONS -- СКОЛ --> SAVE
    REASONS -- ПРОБЛЕМА --> SAVE
    SAVE["Запас −1<br/>наработка снятого сохраняется<br/>нового — с нуля"]

    US34 --> SAVE2["Сообщение связано с заменой<br/>повторное списание не создаётся<br/>сравнение стойкости с нормой"]

    US33 --> PLATES{US-3.5 Пластины}
    PLATES --> N40{Н40 включена?}
    N40 -- Нет --> BASE["Базовый режим:<br/>только ЗАМЕНА ПЛАСТИН<br/>количество + счётчик + причина"]
    N40 -- Да --> EXT["Расширенный:<br/>ПОВОРОТ + грани<br/>Н41 групповой поворот"]
    BASE --> SAVE3["Запас уменьшается<br/>на количество новых пластин"]
    EXT --> SAVE3

    SAVE --> WORK
    SAVE2 --> WORK
    SAVE3 --> WORK

    WORK --> N43{US-3.6<br/>Н43 включена?}
    N43 -- Да --> ZEROPROG["ОБНУЛИТЬ ПРОГНОЗИРОВАНИЕ:<br/>новый временной прогноз<br/>текущее предупреждение снимается"]
    N43 -- Нет --> NOP["Кнопка выключена<br/>(бета-версия)"]
    ZEROPROG --> WORK
    NOP --> WORK