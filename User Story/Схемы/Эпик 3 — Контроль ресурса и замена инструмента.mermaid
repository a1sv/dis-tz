flowchart TD
    classDef us fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef setting fill:#fff3e0,stroke:#ef6c00,color:#e65100
    classDef screen fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20

    START([Работа идёт]) --> PROG["US-3.1<br/>Прогноз наработки:<br/>оценка по времени<br/>и темпу"]
    PROG --> NEXT["Следующее<br/>фактическое показание<br/>уточняет расчёт"]
    NEXT --> N42{"Н42 включена?"}

    N42 -- Нет --> NOALERT["Сигнализатор выключен<br/>(бета-версия)"]
    N42 -- Да --> ALERT["US-3.2<br/>Экран мигает красным<br/>по прогнозу"]

    ALERT --> AUTH["Наладчик авторизуется<br/>проверяет сверло<br/>и отверстия"]
    AUTH --> CONTROL["КОНТРОЛИРУЮ"]
    CONTROL --> STOP["Мигание прекращается<br/>фиксируется сотрудник,<br/>время, инструмент"]
    STOP --> N37{"Н37 включена?"}
    N37 -- Да --> ENTER["Ввод показания<br/>счётчика"]
    N37 -- Нет --> NOENTER["Без показания"]

    ENTER --> WORK([Продолжение работы])
    NOENTER --> WORK
    NOALERT --> WORK

    NEXT --> REPLACE{"Замена?"}
    REPLACE -- Нет --> WORK
    REPLACE -- Да --> EARLY{"Ранняя?<br/>(до предупреждения)"}

    EARLY -- Да --> US34["US-3.4<br/>Ранняя замена:<br/>сообщить о проблеме<br/>признак 'Работа продолжается'"]
    EARLY -- Нет --> US33["US-3.3<br/>Замена сверла"]

    US33 --> STOPM["Остановить станок<br/>взять новое сверло<br/>снять отработанное"]
    STOPM --> REQ["Кнопка СМЕНА ИНСТРУМЕНТА:<br/>фактическое показание<br/>и причина"]
    REQ --> REASONS{"Причина"}
    REASONS -- ХАРАКТЕРНЫЙ ИЗНОС --> SAVE
    REASONS -- ПОЛОМКА --> SAVE
    REASONS -- СКОЛ --> SAVE
    REASONS -- ПРОБЛЕМА --> SAVE

    SAVE["Запас минус 1<br/>наработка снятого<br/>сохраняется<br/>нового с нуля"]

    US34 --> SAVE2["Сообщение связано<br/>с заменой<br/>повторное списание<br/>не создаётся"]

    US33 --> PLATES{"US-3.5<br/>Пластины"}
    PLATES --> N40{"Н40 включена?"}
    N40 -- Нет --> BASE["Базовый режим:<br/>только ЗАМЕНА ПЛАСТИН<br/>количество и счётчик<br/>и причина"]
    N40 -- Да --> EXT["Расширенный:<br/>ПОВОРОТ и грани<br/>Н41 групповой поворот"]
    BASE --> SAVE3["Запас уменьшается<br/>на количество<br/>новых пластин"]
    EXT --> SAVE3

    SAVE --> WORK
    SAVE2 --> WORK
    SAVE3 --> WORK

    WORK --> N43{"US-3.6<br/>Н43 включена?"}
    N43 -- Да --> ZEROPROG["ОБНУЛИТЬ ПРОГНОЗИРОВАНИЕ:<br/>новый временной прогноз<br/>текущее предупреждение<br/>снимается"]
    N43 -- Нет --> NOP["Кнопка выключена<br/>(бета-версия)"]
    ZEROPROG --> WORK
    NOP --> WORK