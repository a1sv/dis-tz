flowchart TD
    START([Работа наладчика]) --> CONN{Связь есть?}
    CONN -- Да --> NORMAL["Обычный режим"]
    CONN -- Нет --> US81["US-8.1 Замена без связи"]

    US81 --> SAVE["Сохранить на планшете<br/>локальный запас и наработка обновлены"]
    SAVE --> STATUS["«Сохранено на планшете,<br/>ожидает отправки»"]
    STATUS --> RESTORE["После восстановления связи<br/>автоматическая передача<br/>с исходным временем"]
    RESTORE --> NODUP["Повторный ввод и движения<br/>не создаются"]

    SAVE --> US82["US-8.2 Неотправленная заявка"]
    US82 --> MSG["«ЗАЯВКА НЕ ОТПРАВЛЕНА.<br/>ПОЗВОНИТЕ МЕНЕДЖЕРУ» + телефон"]
    MSG --> CALL["Менеджер фиксирует количество<br/>которое собирается принести"]

    SAVE --> US83["US-8.3 Приёмка по бумаге"]
    US83 --> PAPER["Менеджер приносит бумажный документ<br/>наладчик сверяет и расписывается"]
    PAPER --> LATER["Позже менеджер вносит<br/>фактически принятое количество"]
    LATER --> LINK["Связать выдачу с заявкой<br/>повторно в планшете не подтверждать"]

    NORMAL --> REBOOT{US-8.4<br/>Перезагрузка планшета?}
    REBOOT -- Да --> RECOVER["Восстановить данные смены<br/>и очередь событий"]
    RECOVER --> NODUP2["Повторная отправка<br/>не создаёт дублей"]
    REBOOT -- Нет --> US85

    NORMAL --> US85["US-8.5 Аварийный ручной режим"]
    US85 --> FAIL{Сервер недоступен /<br/>планшет разбит /<br/>приложение не работает?}
    FAIL -- Да --> PAPER2["Перейти на бумагу<br/>позвонить менеджеру"]
    PAPER2 --> RECORD["Записать: время, место,<br/>деталь, операция, показания,<br/>обнуления, замены, получение,<br/>проблемы и остановки"]
    RECORD --> BLANK["Короткий бланк смены<br/>при нехватке — следующий лист"]
    BLANK --> TRANSFER["После восстановления<br/>менеджер переносит записи<br/>по справочным позициям"]
    TRANSFER --> VERIFY["Сверить электронные<br/>и бумажные записи<br/>без задвоения"]