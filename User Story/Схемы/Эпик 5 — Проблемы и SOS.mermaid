flowchart TD
    START([Проблема на рабочем месте]) --> US51["US-5.1 СООБЩИТЬ О ПРОБЛЕМЕ"]
    US51 --> LIST{Есть в перечне?}
    LIST -- Да --> VOICE["Голос/фото/видео<br/>необязательны"]
    LIST -- Нет --> VOICEREQ["Голосовое описание<br/>обязательно"]
    VOICE --> CONT{Можно<br/>продолжать?}
    VOICEREQ --> CONT

    CONT -- Да --> SEND["Сообщение менеджеру<br/>работа продолжается"]
    CONT -- Нет --> SOS["US-5.2 SOS<br/>ВЫЗВАТЬ СПЕЦИАЛИСТА"]

    SOS --> FIX["Фиксация начала SOS<br/>срочное уведомление"]
    FIX --> STOPPROG["Временной прогноз<br/>приостанавливается"]
    STOPPROG --> STOPEQ["Приложение фиксирует остановку<br/>но не управляет станком"]
    STOPEQ --> ACCEPT["US-5.3 Принятие вызова"]

    ACCEPT --> RESP["ВЫЗОВ ПРИНЯТ — ФИО, роль, время"]
    RESP --> SOLVE["Менеджер отмечает:<br/>время устранения, причина, сторона"]
    SOLVE --> DONE["ПРОБЛЕМА УСТРАНЕНА —<br/>МОЖНО ВОЗОБНОВИТЬ РАБОТУ"]
    DONE --> RESUME["РАБОТА ВОЗОБНОВЛЕНА<br/>ввод показания счётчика"]
    RESUME --> PROG2["Прогноз снова запускается"]

    SOS --> US54["US-5.4 Передача смены при SOS"]
    US54 --> CLOSE["Незавершённый SOS не мешает<br/>закрыть личную смену"]
    CLOSE --> NEXT["Следующий наладчик видит<br/>продолжающуюся остановку<br/>новый SOS не создаётся"]

    SOS --> US55["US-5.5 Отмена ложной тревоги"]
    US55 --> CANCEL["Сохранить отмену<br/>уведомить участников<br/>прекратить эскалацию"]

    SOS --> US56["US-5.6 Эскалация"]
    US56 --> CHAIN["Цепочка ответственных:<br/>уведомление → SMS через 5 мин"]
    CHAIN --> ACCEPTED{Принято<br/>за настроенное время?}
    ACCEPTED -- Нет --> NEXT2["Передать следующему<br/>по вертикали"]
    ACCEPTED -- Да --> RESP2["Ответственный принял<br/>организует решение"]

    SOS --> US57["US-5.7 SOS без связи"]
    US57 --> LOCAL["Сохранить SOS локально<br/>прогноз приостановлен"]
    LOCAL --> SCREEN["«ВЫЗОВ НЕ ОТПРАВЛЕН — НЕТ СВЯЗИ.<br/>ПОЗВОНИТЕ МЕНЕДЖЕРУ» + телефон"]
    SCREEN --> RESTORE["После восстановления связи<br/>передать с исходным временем"]