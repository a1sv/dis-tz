flowchart TD
    START([Наладчик подходит к планшету]) --> CHECK{Открыт сеанс<br/>предыдущего?}

    CHECK -- Да --> CHOICE{Авторизоваться<br/>в нём или<br/>ЗАВЕРШИТЬ СЕАНС?}
    CHOICE -- Авторизоваться --> AUTH12
    CHOICE -- ЗАВЕРШИТЬ СЕАНС --> CLOSE["Закрыть смену<br/>сохранить данные"]
    CLOSE --> FIX["Записать окончание по графику<br/>+ время принуд. завершения<br/>+ факт незакрытия"]
    FIX --> REPORT["Отметка в отчёте руководителя:<br/>«Смена не завершена сотрудником.<br/>Проверить фактическое время ухода»"]
    REPORT --> AUTH12

    CHECK -- Нет --> AUTH12["US-1.2 Авторизация:<br/>крупные фото и ФИО<br/>вход по личному паролю"]

    AUTH12 --> CROSS{Временно<br/>на чужой линии?}
    CROSS -- Да --> FIND["Найти себя в общей базе<br/>войти под своей учёткой"]
    CROSS -- Нет --> LOGIN["Вход выполнен"]
    FIND --> LOGIN

    LOGIN --> WAKE{Планшет<br/>пробуждается?}
    WAKE -- Да --> REAUTH["Повторное подтверждение личности"]
    WAKE -- Нет --> TASK
    REAUTH --> TASK

    TASK["US-1.3 Выбор задания:<br/>доступные детали<br/>3D-изображения"] --> ACT{Действие}
    ACT -- ПРОДОЛЖИТЬ ЗАДАНИЕ --> WORK([Работа])
    ACT -- СМЕНИТЬ ЗАДАНИЕ --> WORK
    ACT -- НЕТ НУЖНОГО ЗАДАНИЯ --> US14["US-1.4:<br/>сообщение менеджеру<br/>временный бумажный учёт"]
    US14 --> WORK